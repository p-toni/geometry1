{
  "name": "geometry",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm pool:build && tsc -b && vite build && pnpm seo:build",
    "pool:build": "vite-node scripts/buildPool.ts",
    "seo:build": "vite-node scripts/buildSeo.ts",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:browser": "node scripts/browserTest.mjs",
    "test:watch": "vitest",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy": "pnpm build && wrangler pages deploy dist --project-name toni-ltd"
  },
  "dependencies": {
    "glimm": "0.3.0",
    "lucide": "^1.33.0",
    "morphicons": "^1.7.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/ui": "^4.1.9",
    "jsdom": "^29.1.1",
    "oxlint": "^1.69.0",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.9",
    "wrangler": "^4.49.0"
  }
}
